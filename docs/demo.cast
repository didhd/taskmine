[0.0, "o", "\u001b[1;36mdemo\u001b[0m \u001b[1;35m$\u001b[0m "]
[0.0, "o", "\u001b[2m# taskmine: turn the pull requests a repository already merged into a Terminal-Bench task set\u001b[0m\r\n\u001b[1;36mdemo\u001b[0m \u001b[1;35m$\u001b[0m "]
[1.001, "o", "\u001b[2m# This repository is synthetic: make_shop.py writes acme/shop with six merged pull requests\u001b[0m\r\n\u001b[1;36mdemo\u001b[0m \u001b[1;35m$\u001b[0m "]
[2.01, "o", "python3 make_shop.py shop\r\n"]
[3.258, "o", "shop: 6 merged pull requests\r\n"]
[3.261, "o", "\u001b[1;36mdemo\u001b[0m \u001b[1;35m$\u001b[0m "]
[4.271, "o", "taskmine init acme/shop --clone shop --recipe shop.toml\r\n"]
[5.096, "o", "\u001b[32m✓ \u001b[0mproject \u001b[1macme/shop\u001b[0m (local clone)\r\n"]
[5.097, "o", "\u001b[2m  clone    shop  (6 merge commits on main)\u001b[0m\r\n"]
[5.097, "o", "\u001b[2m  recipe   taskmine.toml  (1 test runner profiles: node-test)\u001b[0m\r\n"]
[5.097, "o", "\u001b[2m  dataset  .taskmine/out\u001b[0m\r\n"]
