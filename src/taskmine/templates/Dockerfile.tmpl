# Generated by taskmine {version} for {task_id}.
# The repository {repo_name} at the base commit of {unit} ({base_short}), its dependencies
# installed, and nothing from the change the task asks for: that lives in solution/, which only
# Harbor's oracle agent ever copies in. The repository history is not included; /app is a fresh
# git repository with one commit, tagged taskmine-base, that the grader restores test files from.
FROM {image}
ENV CI=1{env}
RUN (command -v git && command -v python3) >/dev/null 2>&1 || (apt-get update \
 && apt-get install -y --no-install-recommends git python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*)
{setup}WORKDIR /app
{deps}COPY repo.tar.gz /tmp/taskmine-repo.tar.gz
RUN tar -xzf /tmp/taskmine-repo.tar.gz -C /app --no-same-owner && rm /tmp/taskmine-repo.tar.gz \
 && git -C /app init -q \
 && printf 'node_modules/\n.venv/\n__pycache__/\n' >> /app/.git/info/exclude \
 && git -C /app config user.name taskmine && git -C /app config user.email taskmine@localhost \
 && git -C /app add -A \
 && GIT_AUTHOR_DATE=2000-01-01T00:00:00Z GIT_COMMITTER_DATE=2000-01-01T00:00:00Z \
    git -C /app commit -q -m "Repository at the task's base commit" \
 && git -C /app tag taskmine-base
